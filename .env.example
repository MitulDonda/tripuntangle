# ─── Database ───────────────────────────────────────────────
# Get free PostgreSQL URL from https://neon.tech
DATABASE_URL=postgresql://neondb_owner:YOUR_DB_PASSWORD@your-host-pooler.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30

# Direct (non-pooler) URL for Prisma migrations
DIRECT_URL=postgresql://neondb_owner:YOUR_DB_PASSWORD@your-host.neon.tech/neondb?sslmode=require&connect_timeout=30

# Get free Redis URL from https://upstash.com
REDIS_URL=rediss://default:YOUR_REDIS_PASSWORD@your-redis-host.upstash.io:6379

# ─── Authentication ──────────────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-32-char-random-secret-here

# ─── AI ──────────────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# ─── Email ───────────────────────────────────────────────────
# Get from https://resend.com (free tier: 3000 emails/month)
RESEND_API_KEY=re_your-resend-key

# Fallback SMTP (optional - only if not using Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password

# ─── Images ──────────────────────────────────────────────────
# Get from https://unsplash.com/developers (free: 50 req/hr)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# ─── App URLs ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ─── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
